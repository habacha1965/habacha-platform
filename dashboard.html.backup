<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Private Portal | HABACHA</title>
    <link rel="stylesheet" href="styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Manrope:wght@500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
    <style>
        /* Noodfix voor de layout als de externe CSS faalt */
        .dashboard-layout { display: flex; min-height: calc(100vh - 80px); background-color: var(--canvas-light); }
        .dashboard-sidebar { width: 280px; background: var(--surface-white); border-right: 1px solid var(--border-subtle-light); padding: 40px 20px; }
        .dashboard-main { flex: 1; padding: 60px; max-width: 1200px; }
        .dashboard-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
        .user-profile { text-align: center; margin-bottom: 40px; padding-bottom: 30px; border-bottom: 1px solid var(--border-subtle-light); }
        .avatar { width: 80px; height: 80px; background: var(--color-navy-main); color: white; font-family: var(--font-heading); font-size: 32px; font-weight: 700; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px auto; }
        .dashboard-nav { list-style: none; padding: 0; }
        .dashboard-nav li { margin-bottom: 10px; }
        .dashboard-nav a { display: block; padding: 12px 15px; text-decoration: none; color: var(--text-light-primary); font-weight: 500; font-size: 14px; border-radius: 4px; }
        .dashboard-nav li.active a { background: var(--canvas-light); color: var(--color-navy-main); font-weight: 600; }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="logo">HABACHA<span>.</span></div>
        <div class="nav-actions">
            <a href="#" id="logoutBtn" class="btn-primary" style="background: transparent; color: var(--color-navy-main); border: 1px solid var(--border-subtle-light);">Sign Out</a>
        </div>
    </nav>

    <div class="dashboard-layout">
        <aside class="dashboard-sidebar">
            <div class="user-profile">
                <div class="avatar" id="userInitial">H</div>
                <h3 id="userName">Loading...</h3>
                <p id="userRole">Private Client</p>
            </div>
            <ul class="dashboard-nav">
                <li class="active"><a href="dashboard.html">Overview</a></li>
                <li><a href="inventory.html">Global Inventory</a></li>
                <li id="addAssetNav" style="display:none;"><a href="add-asset.html" style="color: var(--color-navy-main); font-weight: 700;">+ Add New Asset</a></li>
                <li id="adminNav" style="display:none;"><a href="admin.html" style="color: #ef4444; font-weight: bold;">Admin Verification Desk</a></li>
            </ul>
        </aside>

        <main class="dashboard-main">
            <div class="dashboard-header">
                <h1>Welcome to your portal.</h1>
                <p>Manage your institutional access and inquiries here.</p>
            </div>
            
            <div class="dashboard-grid">
                <div class="inventory-card" style="padding: 30px;">
                    <h3 style="margin-bottom: 15px; color: var(--color-navy-main);">Institutional Status</h3>
                    <span class="badge-institutional" style="position: static; display: inline-block;">VERIFIED</span>
                    <p style="font-size: 13px; color: var(--text-light-secondary); margin-top: 15px;">Your account is fully verified for high-value transactions.</p>
                </div>

                <!-- My Fleet -->
                <div class="inventory-card" id="myFleetBox" style="padding: 30px; grid-column: span 2; display: none;">
                    <h3 style="margin-bottom: 15px; color: var(--color-navy-main);">My Fleet (Active Assets)</h3>
                    <div id="myFleetList" style="font-size: 14px;">
                        <p style="color: var(--text-light-secondary);">Loading assets...</p>
                    </div>
                </div>

                <!-- Inquiries Section -->
                <div class="inventory-card" style="padding: 30px; grid-column: span 2;">
                    <h3 style="margin-bottom: 15px; color: var(--color-navy-main);">Active Inquiries</h3>
                    <div id="inquiriesList" style="font-size: 14px;">
                        <p style="color: var(--text-light-secondary);">Loading inquiries...</p>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Manage Asset Modal -->
    <div id="manageModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(7,13,26,0.8); z-index:1000; align-items:center; justify-content:center;">
        <div style="background:var(--surface-white); padding:40px; border-radius:8px; width:100%; max-width:500px; box-shadow:var(--shadow-institutional); max-height: 90vh; overflow-y: auto;">
            <h2 style="font-family:var(--font-heading); color:var(--color-navy-main); margin-bottom:20px;">Manage Asset</h2>
            <div id="manageModalContent"></div>
            <div style="display:flex; gap:10px; margin-top:30px; flex-wrap: wrap;">
                <button type="button" onclick="closeManageModal()" class="btn-primary" style="background:transparent; color:var(--text-dark); border:1px solid var(--border-subtle-light); flex:1; min-width:100px;">Cancel</button>
                <button type="button" onclick="deleteAssetFromModal()" class="btn-primary" style="background:#ef4444; color:white; border:none; flex:1; min-width:100px;">Remove</button>
                <button type="button" onclick="saveAssetChanges()" id="saveBtn" class="btn-search" style="flex:2; min-width:150px; padding:12px;">Save Changes</button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script>
        const SUPABASE_URL = 'https://fwiyrtchfbjpwrbvzynb.supabase.co';
        const SUPABASE_KEY = 'sb_publishable_rej1BmE3pLsiHB2fOrrGqA_IkcGBCX5';
        const supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

        let fleetAssets = [];
        let activeManageAssetId = null;

        // XSS Escape functie
        function escapeHTML(str) {
            if (!str) return '';
            return str.replace(/[&<>'"]/g, 
                tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
            );
        }

        async function loadDashboard() {
            const { data: { session } } = await supabaseClient.auth.getSession();
            if (!session) { window.location.href = 'login.html'; return; }

            const user = session.user;
            const fullName = user.user_metadata.full_name || user.email.split('@')[0];
            const role = user.user_metadata.role || 'client';
            
            document.getElementById('userName').innerText = fullName;
            document.getElementById('userInitial').innerText = fullName.charAt(0).toUpperCase();
            
            if (role === 'supplier') {
                document.getElementById('userRole').innerText = 'Asset Supplier';
                document.getElementById('addAssetNav').style.display = 'block';
                document.getElementById('myFleetBox').style.display = 'block';
                loadMyFleet(user.id);
            } else {
                document.getElementById('userRole').innerText = 'Private Client';
            }
            
            if (user.email === 'habacha@spamok.nl') {
                document.getElementById('adminNav').style.display = 'block';
            }

            // Load Inquiries
            let query = supabaseClient.from('inquiries').select(`
                id, message, requested_dates, created_at, client_name, client_email, total_price,
                assets (title, category, image_url, location, price_rate, lease_type)
            `).order('created_at', { ascending: false });

            if (role === 'supplier') {
                const { data: myAssets } = await supabaseClient.from('assets').select('id').eq('supplier_id', user.id);
                const assetIds = myAssets.map(a => a.id);
                if (assetIds.length > 0) { query = query.in('asset_id', assetIds); } 
                else { document.getElementById('inquiriesList').innerHTML = '<p style="color: var(--text-light-secondary);">No assets, no inquiries.</p>'; return; }
            } else if (user.email !== 'habacha@spamok.nl') {
                query = query.eq('client_id', user.id);
            }

            const { data: inquiries, error } = await query;
            const listContainer = document.getElementById('inquiriesList');
            
            if (error || !inquiries || inquiries.length === 0) {
                listContainer.innerHTML = '<p style="color: var(--text-light-secondary);">No active inquiries found.</p>';
                return;
            }

            const defaultImages = {
                'Aviation': 'https://images.unsplash.com/photo-1540962351504-03099e0a754b?ixlib=rb-4.0.3&auto=format&fit=crop&w=200&q=80',
                'Maritime': 'https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?ixlib=rb-4.0.3&auto=format&fit=crop&w=200&q=80',
                'Fleets': 'https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?ixlib=rb-4.0.3&auto=format&fit=crop&w=200&q=80',
                'Real Estate': 'https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?ixlib=rb-4.0.3&auto=format&fit=crop&w=200&q=80'
            };

            listContainer.innerHTML = '';
            inquiries.forEach(inq => {
                const date = new Date(inq.created_at).toLocaleDateString();
                const clientInfo = inq.client_name ? `<strong>${escapeHTML(inq.client_name)}</strong> (${escapeHTML(inq.client_email)})` : 'Unknown Client';
                const assetTitle = inq.assets ? inq.assets.title : 'Unknown Asset';
                const assetCat = inq.assets ? inq.assets.category : 'Aviation';
                const assetLoc = inq.assets ? inq.assets.location : 'Global';
                const assetPrice = inq.assets && inq.assets.price_rate ? `$${inq.assets.price_rate.toLocaleString()}` : 'Request Quote';
                const imgUrl = inq.assets && inq.assets.image_url ? inq.assets.image_url : (defaultImages[assetCat] || defaultImages['Aviation']);
                
                listContainer.innerHTML += `
                    <div style="border: 1px solid var(--border-subtle-light); border-radius: 6px; padding: 20px; margin-bottom: 20px; background: white; box-shadow: var(--shadow-institutional);">
                        <div style="display: flex; gap: 20px;">
                            <div style="flex-shrink: 0;"><img src="${imgUrl}" style="width: 120px; height: 90px; object-fit: cover; border-radius: 4px; border: 1px solid var(--border-subtle-light);"></div>
                            <div style="flex: 1;">
                                <div style="display:flex; justify-content:space-between; margin-bottom: 10px;">
                                    <span style="font-family: var(--font-mono); font-size: 10px; color: var(--color-navy-main); font-weight:700; text-transform: uppercase; background: var(--canvas-light); padding: 4px 8px; border-radius: 2px;">INQUIRY: ${clientInfo}</span>
                                    <span style="font-family: var(--font-mono); font-size: 11px; color: var(--text-light-secondary);">${date}</span>
                                </div>
                                <h4 style="font-size: 18px; color: var(--color-navy-main); margin-bottom: 5px; font-family: var(--font-heading);">${escapeHTML(assetTitle)}</h4>
                                <p style="font-size: 13px; color: var(--text-light-secondary); margin-bottom: 5px;">${assetCat} • ${assetLoc} • <strong style="color:var(--color-navy-main);">${assetPrice}</strong></p>
                                <div style="margin-top: 15px; padding: 12px; background: var(--canvas-light); border-left: 2px solid var(--color-platinum);">
                                    <p style="font-size: 12px; color: var(--text-light-secondary); margin-bottom: 5px;"><strong>Dates Requested:</strong> ${inq.requested_dates || 'N/A'}</p>
                                    ${inq.total_price ? `<p style="font-size: 13px; color: var(--color-navy-main); margin-bottom: 5px;"><strong>Est. Total:</strong> $${inq.total_price.toLocaleString()}</p>` : ''}
                                    <p style="font-size: 13px; color: var(--text-light-primary); font-style: italic;">"${escapeHTML(inq.message) || 'No specific message provided.'}"</p>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });
        }

        async function loadMyFleet(supplierId) {
            const { data: assets, error } = await supabaseClient.from('assets').select('*').eq('supplier_id', supplierId).order('created_at', { ascending: false });
            const list = document.getElementById('myFleetList');
            
            const defaultImages = {
                'Aviation': 'https://images.unsplash.com/photo-1540962351504-03099e0a754b?ixlib=rb-4.0.3&auto=format&fit=crop&w=200&q=80',
                'Maritime': 'https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?ixlib=rb-4.0.3&auto=format&fit=crop&w=200&q=80',
                'Fleets': 'https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?ixlib=rb-4.0.3&auto=format&fit=crop&w=200&q=80',
                'Real Estate': 'https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?ixlib=rb-4.0.3&auto=format&fit=crop&w=200&q=80'
            };

            if (error) { list.innerHTML = `<p style="color:red;">Error: ${error.message}</p>`; return; }
            if (assets.length === 0) { list.innerHTML = '<p style="color: var(--text-light-secondary);">You have not added any assets yet.</p>'; return; }

            fleetAssets = assets;
            list.innerHTML = '';
            assets.forEach(asset => {
                const imgUrl = asset.image_url ? asset.image_url : (defaultImages[asset.category] || defaultImages['Aviation']);
                const statusBadge = asset.status === 'verified' 
                    ? '<span style="font-family: var(--font-mono); font-size: 10px; color: #10b981; border: 1px solid #10b981; padding: 2px 6px; border-radius: 2px;">VERIFIED</span>' 
                    : '<span style="font-family: var(--font-mono); font-size: 10px; color: #f59e0b; border: 1px solid #f59e0b; padding: 2px 6px; border-radius: 2px;">PENDING</span>';
                
                list.innerHTML += `
                    <div style="border-bottom: 1px solid var(--border-subtle-light); padding: 15px 0; display: flex; justify-content: space-between; align-items: center;">
                        <div style="display: flex; gap: 20px; align-items: center;">
                            <img src="${imgUrl}" style="width: 80px; height: 60px; object-fit: cover; border-radius: 4px; border: 1px solid var(--border-subtle-light);">
                            <div>
                                <strong style="color: var(--color-navy-main); font-size: 16px;">${escapeHTML(asset.title)}</strong>
                                <p style="font-size: 13px; color: var(--text-light-secondary); margin-top: 4px;">${escapeHTML(asset.category)} • ${escapeHTML(asset.location)}</p>
                                <p style="font-size: 13px; color: var(--text-light-secondary); font-weight: 600;">$${asset.price_rate ? asset.price_rate.toLocaleString() : 'N/A'} / hour</p>
                            </div>
                        </div>
                        <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 10px;">
                            ${statusBadge}
                            <button onclick="openManageModal('${asset.id}')" style="background: transparent; border: 1px solid var(--border-subtle-light); padding: 6px 12px; border-radius: 4px; font-size: 11px; font-weight: 600; cursor: pointer; color: var(--color-navy-main);">Manage Asset</button>
                        </div>
                    </div>
                `;
            });
        }

        window.previewImage = function(event) {
            const file = event.target.files[0];
            if (file) { document.getElementById('preview_image').src = URL.createObjectURL(file); }
        };

        window.openManageModal = function(id) {
            const asset = fleetAssets.find(a => a.id === id);
            if (!asset) return;
            activeManageAssetId = id;
            
            let specsHtml = '';
            if (asset.specs && Object.keys(asset.specs).length > 0) {
                for (const [key, value] of Object.entries(asset.specs)) {
                    // Fix: Sla null waarden over
                    if (value && value !== 'null' && value !== '') {
                        specsHtml += `
                        <div class="search-field" style="border: 1px solid var(--border-subtle-light); border-radius: 4px; padding: 8px; margin-bottom: 8px; background: white;">
                            <label style="font-size: 10px;">${key.toUpperCase()}</label>
                            <input type="text" id="edit_spec_${key}" value="${escapeHTML(value)}" style="width: 100%; border: none; outline: none; font-family: var(--font-body);">
                        </div>`;
                    }
                }
            }
            
            if (specsHtml === '') specsHtml = '<p style="font-size:12px; color:var(--text-light-secondary);">No specific specs provided.</p>';

            const currentImg = asset.image_url ? asset.image_url : 'https://images.unsplash.com/photo-1540962351504-03099e0a754b?ixlib=rb-4.0.3&auto=format&fit=crop&w=200&q=80';

            document.getElementById('manageModalContent').innerHTML = `
                <div style="margin-bottom: 20px; text-align: center;">
                    <img id="preview_image" src="${currentImg}" style="width: 100%; height: 150px; object-fit: cover; border-radius: 4px; margin-bottom: 10px; border: 1px solid var(--border-subtle-light);">
                    <label style="cursor: pointer; display: inline-block; padding: 8px 16px; background: var(--canvas-light); border: 1px solid var(--border-subtle-light); border-radius: 4px; font-size: 12px; font-weight: 600; color: var(--color-navy-main);">
                        Upload New Image
                        <input type="file" id="edit_image" accept="image/*" style="display: none;" onchange="previewImage(event)">
                    </label>
                </div>
                <div class="search-field" style="border: 1px solid var(--border-subtle-light); border-radius: 4px; padding: 10px; margin-bottom: 10px;">
                    <label>Asset Title</label>
                    <input type="text" id="edit_title" value="${escapeHTML(asset.title)}" style="width: 100%; border: none; outline: none; font-family: var(--font-body);">
                </div>
                <div class="search-field" style="border: 1px solid var(--border-subtle-light); border-radius: 4px; padding: 10px; margin-bottom: 10px;">
                    <label>Location</label>
                    <input type="text" id="edit_location" value="${escapeHTML(asset.location)}" style="width: 100%; border: none; outline: none; font-family: var(--font-body);">
                </div>
                <div class="search-field" style="border: 1px solid var(--border-subtle-light); border-radius: 4px; padding: 10px; margin-bottom: 15px;">
                    <label>Current Rate (USD / hour)</label>
                    <input type="number" id="edit_price" value="${asset.price_rate || 0}" style="width: 100%; border: none; outline: none; font-family: var(--font-body);">
                </div>
                <div style="padding: 15px; background: var(--canvas-light); border: 1px solid var(--border-subtle-light); border-radius: 4px; margin-bottom: 20px;">
                    <h4 style="font-family: var(--font-mono); font-size: 11px; color: var(--color-navy-main); margin-bottom: 10px; text-transform: uppercase;">Specs & Compliance</h4>
                    ${specsHtml}
                </div>
            `;
            document.getElementById('manageModal').style.display = 'flex';
            document.getElementById('saveBtn').innerText = 'Save Changes'; // Reset knop
        };

        window.closeManageModal = function() {
            document.getElementById('manageModal').style.display = 'none';
            activeManageAssetId = null;
            document.getElementById('saveBtn').innerText = 'Save Changes'; // Reset knop
        };

        window.deleteAssetFromModal = async function() {
            if(!activeManageAssetId) return;
            if(!confirm("Are you sure you want to permanently remove this asset from the network? This cannot be undone.")) return;
            const { data: { session } } = await supabaseClient.auth.getSession();
            const { error } = await supabaseClient.from('assets').delete().eq('id', activeManageAssetId).eq('supplier_id', session.user.id);
            if(error) { alert('Error deleting asset: ' + error.message); } 
            else { alert('Asset successfully removed.'); closeManageModal(); loadMyFleet(session.user.id); }
        };

        window.saveAssetChanges = async function() {
            if(!activeManageAssetId) return;
            const btn = document.getElementById('saveBtn');
            btn.innerText = 'Saving...';
            
            const asset = fleetAssets.find(a => a.id === activeManageAssetId);
            let updatedSpecs = { ...asset.specs };
            
            if (asset.specs) {
                for (const key of Object.keys(asset.specs)) {
                    const input = document.getElementById('edit_spec_' + key);
                    if (input) updatedSpecs[key] = input.value;
                }
            }

            let newImageUrl = asset.image_url;
            const fileInput = document.getElementById('edit_image');
            if (fileInput.files.length > 0) {
                const file = fileInput.files[0];
                const fileExt = file.name.split('.').pop();
                const fileName = `${Math.random()}.${fileExt}`;
                const filePath = `${asset.supplier_id}/${fileName}`;

                const { error: uploadError } = await supabaseClient.storage.from('asset-images').upload(filePath, file);
                if (uploadError) {
                    alert('Error uploading image: ' + uploadError.message);
                    btn.innerText = 'Save Changes';
                    return;
                }
                const { data: { publicUrl } } = supabaseClient.storage.from('asset-images').getPublicUrl(filePath);
                newImageUrl = publicUrl;
            }

            const updates = {
                title: document.getElementById('edit_title').value,
                location: document.getElementById('edit_location').value,
                price_rate: parseFloat(document.getElementById('edit_price').value),
                specs: updatedSpecs,
                image_url: newImageUrl
            };

            const { error } = await supabaseClient.from('assets').update(updates).eq('id', activeManageAssetId);

            if (error) {
                alert('Error saving changes: ' + error.message);
                btn.innerText = 'Save Changes';
            } else {
                alert('Asset successfully updated.');
                closeManageModal(); // Sluit de modal netjes
                const { data: { session } } = await supabaseClient.auth.getSession();
                loadMyFleet(session.user.id); // Herlaad de lijst
            }
        };

        document.getElementById('logoutBtn').addEventListener('click', async (e) => {
            e.preventDefault();
            await supabaseClient.auth.signOut();
            window.location.href = 'index.html';
        });

        loadDashboard();
    </script>
</body>
</html>
