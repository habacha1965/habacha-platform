<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HABACHA | Institutional Exchange for High-Value Assets</title>
    <meta name="description" content="Institutional Asset Allocation. Connecting global enterprises and private clients with verified real estate, private aviation, heavy maritime, and commercial fleet operations.">
    <link rel="stylesheet" href="styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Manrope:wght@500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">

    <!-- SEO & Open Graph -->
    <link rel="icon" type="image/svg+xml" href="https://api.iconify.design/lucide:shield-check.svg?color=%23C5C6C8">
    <meta property="og:title" content="HABACHA | Institutional Exchange for High-Value Assets">
    <meta property="og:description" content="The premier global exchange for private aviation, superyachts, luxury real estate, and commercial fleets. Vetted liquidity. Institutional escrow.">
    <meta property="og:image" content="https://images.unsplash.com/photo-1540962351504-03099e0a754b?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&h=630&q=80">
    <meta property="og:url" content="https://habacha.com">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="HABACHA | Institutional Exchange">
    <meta name="twitter:description" content="Institutional Asset Allocation for Private Aviation, Maritime, and Real Estate.">
    <meta name="twitter:image" content="https://images.unsplash.com/photo-1540962351504-03099e0a754b?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&h=630&q=80">

</head>
<body>
    <nav class="navbar">
        <div class="logo">HABACHA<span>.</span></div>
        
        <!-- DE LINKS ZIJN NU 100% CORRECT -->
        <div class="mode-switcher">
            <a href="inventory.html?tier=private" class="mode-btn active" style="text-decoration: none;">Private Clients</a>
            <a href="inventory.html?tier=enterprise" class="mode-btn" style="text-decoration: none;">Enterprise & Logistics</a>
        </div>
        <ul class="nav-links">
            <li><a href="inventory.html?category=Real Estate">Accommodations</a></li>
            <li><a href="inventory.html?category=Aviation">Aviation</a></li>
            <li><a href="inventory.html?category=Maritime">Maritime</a></li>
            <li><a href="inventory.html?category=Fleets">Commercial Fleets</a></li>
        </ul>
        
        <button class="hamburger" id="hamburgerBtn" aria-label="Menu">
            <span></span>
            <span></span>
            <span></span>
        </button>
    <div class="nav-actions">
            <a href="login.html" class="btn-primary">Client Login</a>
        </div>
    </nav>

    <header class="hero">
        <div class="hero-content">
            <h1>The Institutional Exchange for High-Value Assets.</h1>
            <p>Institutional Asset Allocation. Connecting global enterprises and private clients with verified real estate, private aviation, heavy maritime, and commercial fleet operations.</p>
            
            <div class="search-container">
                <div class="search-field">
                    <label>Location / Port / Airport</label>
                    <input type="text" placeholder="e.g., Port of Rotterdam, JFK, Monaco, Dubai">
                </div>
                <div class="search-field">
                    <label>Asset Class</label>
                    <select>
                        <option>Accommodation</option>
                        <option>Private Aviation</option>
                        <option>Maritime</option>
                        <option>Commercial Fleet</option>
                    </select>
                </div>
                <div class="search-field">
                    <label>Requirements</label>
                    <input type="text" placeholder="Pax, NM Range, Bareboat / Wet Lease...">
                </div>
                <button class="btn-search">Search Network</button>
            </div>
        </div>
    </header>

    <div class="social-proof">
        <div class="stat"><strong>$1.2B+</strong> Assets Under Network</div>
        <div class="stat-divider"></div>
        <div class="stat"><strong>140+</strong> Jurisdictions Covered</div>
        <div class="stat-divider"></div>
        <div class="stat"><strong>Strict</strong> Escrow Protocol</div>
    </div>

    <section class="featured">
        <div class="section-header">
            <h2>Curated Inventory</h2>
            <a href="inventory.html" class="view-all">View Full Portfolio &rarr;</a>
        </div>
        <div class="listing-grid">
            <div class="inventory-card">
                <div class="image-container">
                    <img src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Luxury Villa">
                    <div class="badge-institutional">NDA Compliant</div>
                </div>
                <div class="listing-info">
                    <h3>Palm Jumeirah Signature Villa</h3>
                    <p>Private Estate Lease • Dubai, UAE</p>
                    <div class="price">From $2,500 <span>/ night</span></div>
                    <a href="inventory.html" class="specialist-link">Speak with Asset Specialist &rarr;</a>
                </div>
            </div>
            <div class="inventory-card">
                <div class="image-container">
                    <img src="https://images.unsplash.com/photo-1540962351504-03099e0a754b?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Private Jet">
                    <div class="badge-institutional">Verified Operator</div>
                </div>
                <div class="listing-info">
                    <h3>Gulfstream G650</h3>
                    <p>Private Aviation • Global</p>
                    <div class="price">From $8,500 <span>/ hour</span></div>
                    <a href="inventory.html" class="specialist-link">Speak with Asset Specialist &rarr;</a>
                </div>
            </div>
            <div class="inventory-card">
                <div class="image-container">
                    <img src="https://images.unsplash.com/photo-1567899378494-47b22a2ae96a?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Luxury Yacht">
                    <div class="badge-institutional">Institutional Escrow</div>
                </div>
                <div class="listing-info">
                    <h3>Benetti 108 Superyacht</h3>
                    <p>Bareboat Charter • Monaco</p>
                    <div class="price">From $15,000 <span>/ day</span></div>
                    <a href="inventory.html" class="specialist-link">Speak with Asset Specialist &rarr;</a>
                </div>
            </div>
        </div>
    </section>

    <section class="supplier-cta" id="b2b">
        <div class="cta-content">
            <h2>Capital Deployment & Fleet Monetization</h2>
            <p>Join HABACHA's global network of verified suppliers. We provide institutional escrow and full discretion for high-value assets and commercial fleets.</p>
            <a href="onboarding.html" class="btn-ghost">Request Institutional Access</a>
            <p class="cta-sub">Vetted Liquidity & Performance-Based Settlement.</p>
        </div>
    </section>

    <footer>
        <div class="footer-content">
            <div class="footer-brand">
                <div class="logo">HABACHA<span>.</span></div>
                <p>The premier institutional exchange for high-value asset rentals.</p>
            </div>
            <div class="footer-links">
                <h4>Platform</h4>
                <a href="inventory.html?tier=private">Private Clients</a>
                <a href="inventory.html?tier=enterprise">Enterprise</a>
                <a href="inventory.html">Global Inventory</a>
            </div>
            <div class="footer-links">
                <h4>Company</h4>
                <a href="about.html">About Us</a>
                <a href="onboarding.html">Supplier Access</a>
            </div>
            <div class="footer-links">
                <h4>Legal</h4>
                <a href="terms.html">Terms of Service</a>
                <a href="privacy.html">Privacy Policy</a>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 HABACHA Global. All rights reserved.</p>
        </div>
    </footer>

        <!-- Mobile Menu -->
        <div class="mobile-menu" id="mobileMenu">
            <div class="mobile-menu-header">
                <div class="logo">HABACHA<span>.</span></div>
                <button class="close-menu" id="closeMenuBtn">&times;</button>
            </div>
            <ul class="mobile-nav-links">
                <li><a href="inventory.html?tier=private">Private Clients</a></li>
                <li><a href="inventory.html?tier=enterprise">Enterprise & Logistics</a></li>
                <hr style="border: 1px solid var(--border-subtle-dark); margin: 20px 0;">
                <li><a href="inventory.html?category=Real Estate">Accommodations</a></li>
                <li><a href="inventory.html?category=Aviation">Aviation</a></li>
                <li><a href="inventory.html?category=Maritime">Maritime</a></li>
                <li><a href="inventory.html?category=Fleets">Commercial Fleets</a></li>
                <hr style="border: 1px solid var(--border-subtle-dark); margin: 20px 0;">
                <li><a href="onboarding.html" style="color: var(--color-platinum);">List Your Asset</a></li>
                <li><a href="login.html">Client Login</a></li>
            </ul>
        </div>
        
    <script>
        const hamburgerBtn = document.getElementById('hamburgerBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        const closeMenuBtn = document.getElementById('closeMenuBtn');

        if(hamburgerBtn) {
            hamburgerBtn.addEventListener('click', () => {
                mobileMenu.classList.add('open');
            });
        }

        if(closeMenuBtn) {
            closeMenuBtn.addEventListener('click', () => {
                mobileMenu.classList.remove('open');
            });
        }
    </script>
    </body>
</html>
